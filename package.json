{
  "name": "acrazie-portfolio",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "test": "bun run paraglide:compile && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome lint .",
    "typecheck": "bun run paraglide:compile && tsc --noEmit",
    "bundle:summary": "bun scripts/bundle-summary.mjs",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "postinstall": "test -d .git && which git > /dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.13",
    "@inlang/paraglide-js": "^2.25.2",
    "@inlang/paraglide-vite": "^1.4.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "nitro": "^3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "lefthook": "^1.11.0"
  }
}
